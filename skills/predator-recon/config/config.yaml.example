# Predator Recon Configuration
# Copy to ~/.config/predator-recon/config.yaml

# ─── CALCULUS THRESHOLDS ───
# Every tool run must pass: Value > Cost + Risk + Irreversibility
calculus:
  min_value_usd: 1000           # Skip targets below this bounty/impact
  max_cost_minutes: 30          # Skip tools taking longer
  max_risk_score: 7             # 1-10, skip if higher
  require_clean_exit: true      # Must have rollback path
  min_clean_score: 6            # 1-10, exit cleanliness

# ─── TOOL LIMITS ───
tool_limits:
  nuclei_rate_limit: 100
  httpx_threads: 50
  katana_depth: 3
  gau_timeout: 30
  sqlmap_threads: 5
  dalfox_workers: 100
  ffuf_threads: 50
  puredns_rate_limit: 10000
  naabu_rate: 10000
  naabu_top_ports: 1000

# ─── PHASE GATES (Calculus-Driven) ───
phase_gates:
  phase1_subdomain:
    enabled: true
    run_active_bruteforce: false      # Only if Calculus allows
    min_passive_subs: 50              # If less, consider active

  phase2_urls:
    enabled: true
    max_urls_per_target: 5000
    filter_live_only: true            # Only httpx 200 OK

  phase3_js:
    enabled: true
    max_js_files: 200                 # Limit download

  phase3_vuln:
    enabled: true
    max_params_per_target: 500
    run_sqli: true
    run_xss: true
    run_ssti: true
    run_cors: true
    run_redirect: true
    run_ssrf: true
    run_idor: true
    run_takeover: true

  phase4_infra:
    enabled: true
    port_scan_top_ports: 1000
    check_ssl: true
    check_cloud_metadata: true

  phase5_onchain:
    enabled: true
    max_contracts: 20
    storage_slots: 50
    simulate_before_exploit: true

# ─── DEEP MODE ───
deep_mode:
  trigger_attempts: 3                 # Trigger after N failed vectors
  simulate_best_worst_adversarial: true
  pre_commit_decisions: true
  abort_on_gas_spike: 2.0             # 2x normal gas

# ─── TROJAN MODE ───
trojan_mode:
  trigger_after_failed_vectors: 3
  auto_analyze_gatekeepers: true
  min_visible_value_score: 6          # 1-10, visible value must survive scrutiny
  require_rollback_test: true

# ─── ANTI-DELUSION ───
anti_delusion:
  blind_spot_check_after_phase: true
  flag_confirmation_bias: true
  flag_sunk_cost: true
  flag_narrative_fallacy: true
  flag_false_urgency: true
  flag_ego_escalation: true
  flag_assumption_as_fact: true
  flag_fabricated_evidence: true
  flag_unverified_success: true
  flag_complexity_hiding_uncertainty: true

# ─── OUTPUT ───
output:
  structured_json: true
  keep_raw_logs: false
  assumptions_log: true
  evidence_screenshots: true
  tx_hash_verification: true
  output_dir: "~/predator-recon/$(date +%Y%m%d-%H%M)"

# ─── ENVIRONMENT VARIABLES ───
# Set these in your shell or .bashrc
# XSS_SERVER_URL=https://your-xss-server.com
# ETH_RPC_URL=https://eth.llamarpc.com
# ARB_RPC_URL=https://arb1.arbitrum.io/rpc
# BSC_RPC_URL=https://bsc-dataseed.binance.org
# GITHUB_TOKEN=ghp_xxx (for github-subdomains)
# SHODAN_API_KEY=xxx (optional)
# VIRUSTOTAL_API_KEY=xxx (optional)